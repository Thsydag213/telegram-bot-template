# Скопируй этот файл в .env и заполни. Обязательные поля отмечены (!).
# Файл .env в репозиторий не коммитится — там секреты.

# ── Telegram ──────────────────────────────────────────────────────────────────

# (!) Токен бота от @BotFather
BOT_TOKEN=123456789:replace-me

# (!) Telegram ID админов через запятую. Свой ID можно узнать у @userinfobot
ADMIN_IDS=123456789

# Группа организаторов: сюда приходят пруфы и уведомления о сверке.
# Создай группу, добавь бота, узнай ID группы (обычно начинается с -100).
# Обязательно, если включено бинго.
ADMIN_CHAT_ID=-1001234567890

# ── Модули (1 — включён, 0 — выключен) ────────────────────────────────────────

# Сверка пришедших со списком участников из Google-таблицы.
# Выключен — в бота пускают всех.
FEATURE_SCREENING=1
# Программа ивента, которую админы меняют командой /set_agenda
FEATURE_AGENDA=1
# Бинго: задания, пруфы, проверка в админ-чате, победители
FEATURE_BINGO=1

# ── Ивент ─────────────────────────────────────────────────────────────────────

# Название — подставляется в приветствие
EVENT_NAME=Мой ивент
# Канал с анонсами. Оставь пустым, если канала нет
CHANNEL_URL=
# Часовой пояс ивента относительно UTC (Москва = 3, Алматы = 5)
TIMEZONE_OFFSET=3
# Сколько заданий нужно для победы. Пусто — все задания из content/tasks.py
WIN_THRESHOLD=

# ── База данных ───────────────────────────────────────────────────────────────

# (!) PostgreSQL. При запуске через docker compose задавать не нужно.
DATABASE_URL=postgresql://user:password@localhost:5432/bot

# Запасной адрес: бот переключится на него, если основной не отвечает.
# Например, на Railway: DATABASE_URL = ${{Postgres.DATABASE_URL}},
# DATABASE_FALLBACK_URL = ${{Postgres.DATABASE_PUBLIC_URL}}
DATABASE_FALLBACK_URL=

# ── Google-таблица (необязательно) ───────────────────────────────────────────
# Нужна для сверки участников и дублирования данных в таблицу.
# Пошаговая настройка: docs/google-sheets.md

# ID таблицы — часть URL между /d/ и /edit
GOOGLE_SPREADSHEET_ID=
# Ключ service account: содержимое JSON-файла одной строкой...
GOOGLE_CREDENTIALS_JSON=
# ...или путь к файлу ключа (удобно при локальном запуске)
GOOGLE_CREDENTIALS_FILE=

# Названия листов
SHEET_DELEGATES=Делегаты
SHEET_REGISTRATIONS=Регистрации
SHEET_PROGRESS=Прогресс

# ── Тонкая настройка (можно не трогать) ──────────────────────────────────────

# Если список участников не загрузился: false — пускать всех, true — никого
SCREENING_STRICT=false
# Как часто перечитывать список участников из таблицы, минут
DELEGATES_REFRESH_MINUTES=5
# Антиспам: больше SPAM_MAX_SUBMISSIONS пруфов за SPAM_WINDOW_SECONDS —
# приём заявок от участника на паузе SPAM_MUTE_SECONDS
SPAM_WINDOW_SECONDS=300
SPAM_MAX_SUBMISSIONS=6
SPAM_MUTE_SECONDS=900
# Запись в таблицу пачками раз в N секунд
SHEETS_FLUSH_SECONDS=5
